# Copiar como .env, al lado de app.py. Pegar la clave solamente en .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Vía OpenRouter, con el mismo SDK: reemplazar las dos líneas de arriba por estas.
# Fijar un modelo de chat concreto; los routers como openrouter/free pueden caer en
# un clasificador de moderación y devolver un veredicto en vez del informe.
# OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Alternativa local: elegir ollama en Generador, sin clave de OpenAI.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
